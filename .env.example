# Public browser configuration (use a domain-restricted Mapbox public token).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Local importer and GitHub Actions secrets. Never use NEXT_PUBLIC_ for these.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Relative to your Dropbox app's accessible root; / explicitly selects that root.
DROPBOX_FOLDER_PATH=/PortfolioMap

# Optional upload-triggered webhook: Vercel server-only environment variables.
# DROPBOX_APP_SECRET is also required in Vercel for signature verification.
GITHUB_SYNC_TOKEN=
GITHUB_SYNC_REPOSITORY=austyn-nguyen/portfolio
# Optional: accept notifications only for this Dropbox account.
DROPBOX_ACCOUNT_ID=

# GitHub Actions only; a Vercel Deploy Hook for the production branch.
VERCEL_DEPLOY_HOOK_URL=

# Spotify listening section: server-only Vercel and local environment variables.
# Create an app, then run npm run spotify:authorize. See docs/spotify-listening.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional override for the public profile link in src/data/music-listening.ts.
SPOTIFY_PROFILE_URL=
